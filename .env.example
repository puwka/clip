# Supabase Project URL and secret (server only)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Browser → FastAPI. Keep these aligned with the listening ports.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
FRONTEND_ORIGIN=http://127.0.0.1:3000

# Local storage, relative to the project root or an absolute path
CLIP_DATA_DIR=data
CLIP_MAX_UPLOAD_GB=20
TWITCH_DISK_RESERVE_GB=5

# Executable names on PATH, or absolute paths
FFMPEG=ffmpeg
FFPROBE=ffprobe

# Local AI models
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
WHISPER_MODEL=base
WHISPER_THREADS=6
